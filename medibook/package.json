{
  "name": "medibook-ai",
  "version": "0.1.0",
  "private": true,
  "description": "AI receptionist that books, reschedules and cancels doctor appointments online and over the phone.",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning src/index.js",
    "dev": "node --disable-warning=ExperimentalWarning --watch src/index.js",
    "seed": "node --disable-warning=ExperimentalWarning scripts/seed.js",
    "create-clinic": "node --disable-warning=ExperimentalWarning scripts/create-clinic.js",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.js",
    "call": "node --disable-warning=ExperimentalWarning scripts/call-simulator.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "express": "^5.2.1"
  }
}
