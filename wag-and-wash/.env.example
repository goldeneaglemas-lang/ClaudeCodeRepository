# Copy to .env and fill in.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/wagwash"

# Used by `npm test`. Each run creates its own throwaway database on this
# server and drops it afterwards. The user needs permission to create databases.
TEST_DATABASE_SERVER_URL="postgresql://postgres:postgres@localhost:5432"

# Public address of the site, used in links sent to Stripe. Optional locally.
# APP_URL="https://book.wagandwash.com"

# Payments. Leave STRIPE_SECRET_KEY empty to use the built-in test checkout
# page (local development only; production refuses to run without it).
# Get test keys at https://dashboard.stripe.com/test/apikeys
STRIPE_SECRET_KEY=""
# From `stripe listen` locally, or the webhook endpoint in the Stripe dashboard
# (endpoint: /api/webhooks/stripe; events: checkout.session.completed,
# checkout.session.async_payment_succeeded, checkout.session.expired).
STRIPE_WEBHOOK_SECRET=""

# Protects /api/cron/expire-holds. Required in production.
CRON_SECRET=""

# Signs sign-in codes. Required in production: any long random string,
# e.g. from `openssl rand -base64 32`.
AUTH_SECRET=""

# Texts (sign-in codes now; reminders in step 6). Leave empty locally: codes are
# then shown on screen instead of texted. Production refuses to run without them.
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM_NUMBER=""

# Added in later steps:
# OWNER_EMAIL=
# OWNER_PASSWORD=
